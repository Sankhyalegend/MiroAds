# Copy to backend/.env and fill in. Never commit .env.

# Your Anthropic API key (create one in its own workspace with a spend cap).
ANTHROPIC_API_KEY=

# auto = Anthropic when a key is set, otherwise the deterministic fake provider ($0).
LLM_PROVIDER=auto

# Crowd agents: cheap and plentiful. Analysts: research team + report.
CROWD_MODEL=claude-haiku-5-5
ANALYST_MODEL=claude-sonnet-5-5
# Market scan research (web search reads every result, 100K+ tokens). Defaults to the crowd model.
# MARKET_MODEL=claude-haiku-5-5

# true = analysts also run on the crowd model (about 4x cheaper per run). Set false for real reports.
DEV_MODE=true

# Hard cap per run; the run finalizes early if exceeded.
RUN_BUDGET_USD=2.0

# Parallel LLM calls. Lower it if you hit rate limits on a new account.
MAX_CONCURRENCY=24
